{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/module",
      "has": [{ "type": "query", "key": "id", "value": "platform" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/module",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>[a-z]+)" }],
      "destination": "/modules/:id",
      "permanent": true
    },
    {
      "source": "/module",
      "destination": "/",
      "permanent": true
    }
  ]
}
